# Shared model config for every script in this repo.
# Default: local Qwen served by Ollama (zero cost, no key needed).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=ollama

# OpenAI alternative: uncomment these three and comment out the block above.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.4-mini
# LLM_API_KEY=sk-...
